{
  "name": "@voyzu/types",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./internal-api": { "types": "./src/internal-api.ts", "import": "./src/internal-api.ts" },
    "./business-objects/customer": { "types": "./src/business-objects/customer.ts", "import": "./src/business-objects/customer.ts" },
    "./business-objects/party": { "types": "./src/business-objects/party.ts", "import": "./src/business-objects/party.ts" },
    "./identity": { "types": "./src/identity.ts", "import": "./src/identity.ts" },
    "./contracts": { "types": "./src/contracts.ts", "import": "./src/contracts.ts" },
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "import": "./src/errors/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts"
    },
    "./framework": {
      "types": "./src/framework.ts",
      "import": "./src/framework.ts"
    },
    "./modules": {
      "types": "./src/modules/index.ts",
      "import": "./src/modules/index.ts"
    },
    "./modules/core": {
      "types": "./src/modules/core/index.ts",
      "import": "./src/modules/core/index.ts"
    },
    "./params": {
      "types": "./src/params/index.ts",
      "import": "./src/params/index.ts"
    }
  },
  "peerDependencies": {
    "typebox": "^1.3.7"
  }
}
