{
  "operationId": "createOrganization",
  "method": "post",
  "path": "/organization/organizations",
  "summary": "Create organization",
  "description": "Creates a organization record from a JSON request body.",
  "requestBody": {
    "required": true,
    "schema": {
      "type": "object",
      "required": ["code", "name", "countryCode", "baseCurrencyCode"],
      "properties": {
        "code": {
          "type": "string",
          "description": "Stable organization code."
        },
        "name": {
          "type": "string",
          "description": "Organization display name."
        },
        "countryCode": {
          "type": "string",
          "description": "Country code for localization and tax setup."
        },
        "baseCurrencyCode": {
          "type": "string",
          "description": "Base currency code used for organization reporting."
        },
        "taxFilingAnchorMonth": {
          "type": "number",
          "description": "Optional tax filing anchor month."
        },
        "taxFilingIntervalMonths": {
          "type": "number",
          "enum": [1, 2, 3, 6, 12],
          "description": "Optional tax filing interval."
        }
      }
    },
    "example": {
      "code": "ACME-US",
      "name": "Acme United States Inc",
      "countryCode": "US",
      "baseCurrencyCode": "USD"
    }
  },
  "responses": {
    "201": {
      "description": "The created organization.",
      "schema": {
        "type": "object",
        "required": ["id", "code", "name", "countryCode", "baseCurrencyCode", "status"],
        "properties": {
          "id": {
            "type": "number",
            "description": "Unique numeric identifier for the organization."
          },
          "code": {
            "type": "string",
            "description": "Stable organization code."
          },
          "name": {
            "type": "string",
            "description": "Organization display name."
          },
          "countryCode": {
            "type": "string",
            "description": "Country code used for organization localization."
          },
          "baseCurrencyCode": {
            "type": "string",
            "description": "Base currency code used for organization reporting."
          },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "INACTIVE"],
            "description": "Current organization status."
          }
        }
      },
      "example": {
        "id": 10005,
        "code": "ACME-US",
        "name": "Acme United States Inc",
        "countryCode": "US",
        "baseCurrencyCode": "USD",
        "status": "ACTIVE"
      }
    },
    "400": {
      "description": "Validation failed.",
      "modelReference": "See Error Response Model"
    },
    "409": {
      "description": "A organization with this code already exists.",
      "modelReference": "See Error Response Model"
    }
  }
}
