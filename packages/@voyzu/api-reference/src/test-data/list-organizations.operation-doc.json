{
  "operationId": "listOrganizations",
  "method": "get",
  "path": "/organization/organizations",
  "summary": "List organizations",
  "description": "Returns the organizations available in the organization.",
  "responses": {
    "200": {
      "description": "A list of all organizations.",
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "code", "name", "countryCode", "baseCurrencyCode", "status"],
          "properties": {
            "id": {
              "type": "number",
              "description": "Unique numeric identifier for the organization."
            },
            "code": {
              "type": "string",
              "description": "Stable organization code."
            },
            "name": {
              "type": "string",
              "description": "Organization display name."
            },
            "countryCode": {
              "type": "string",
              "description": "Country code used for organization localization."
            },
            "baseCurrencyCode": {
              "type": "string",
              "description": "Base currency code used for organization reporting."
            },
            "status": {
              "type": "string",
              "enum": ["ACTIVE", "INACTIVE"],
              "description": "Current organization status."
            }
          }
        }
      },
      "example": [
        {
          "id": 10001,
          "code": "SAMP-AU",
          "name": "Acme Australia Pty Ltd",
          "countryCode": "AU",
          "baseCurrencyCode": "AUD",
          "status": "ACTIVE"
        }
      ]
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "modelReference": "See Error Response Model"
    }
  }
}
