{
  "name": "@voyzu/organization",
  "version": "0.1.0",
  "description": "Preinstalled organization management, access and selection.",
  "repository": "https://github.com/chrisjameslennon/voyzu.git",
  "private": true,
  "type": "module",
  "voyzu": {
    "voyzu-package": true,
    "allowInstall": true,
    "dependencies": [
      "@voyzu/localization"
    ],
    "pageRootPaths": [
      "/organization"
    ],
    "apiRootPaths": [
      "/organization",
      "/organization-selection"
    ],
    "settings": {
      "helpBaseUrl": "https://voyzu.gitbook.io/docs/"
    },
    "preinstalled": true
  },
  "exports": {
    "./package.json": "./package.json",
    "./voyzu-package": "./voyzu.package.ts",
    "./navigation": "./navigation/index.ts",
    "./organizations": "./modules/organizations/module.ts",
    "./organizations/pages.routes": "./modules/organizations/pages.routes.ts",
    "./organizations/api.routes": "./modules/organizations/api.routes.ts",
    "./organizations/client": "./modules/organizations/client/index.ts",
    "./organizations/server": "./modules/organizations/server/index.ts",
    "./organizations/domain/operation-policy": "./modules/organizations/domain/operation-policy.ts",
    "./organization-switcher": "./modules/organization-switcher/module.ts",
    "./organization-switcher/api.routes": "./modules/organization-switcher/api.routes.ts",
    "./organization-switcher/server": "./modules/organization-switcher/server/index.ts",
    "./organization-switcher/types": "./modules/organization-switcher/types/index.ts",
    "./organization-access": "./modules/organization-access/module.ts",
    "./organization-access/pages.routes": "./modules/organization-access/pages.routes.ts",
    "./organization-access/api.routes": "./modules/organization-access/api.routes.ts",
    "./organization-access/client": "./modules/organization-access/client/index.ts",
    "./organization-access/server": "./modules/organization-access/server/index.ts",
    "./organization-reports": "./modules/organization-reports/module.ts",
    "./organization-reports/pages.routes": "./modules/organization-reports/pages.routes.ts",
    "./organization-reports/server": "./modules/organization-reports/server/index.ts",
    "./common/client": "./modules/common/client/index.ts",
    "./common/server": "./modules/common/server/index.ts",
    "./common/domain/operation-policy": "./modules/common/domain/operation-policy.ts",
    "./types/constraints": "./types/constraints.ts",
    "./types/modules/*": "./types/modules/*/index.ts",
    "./types/modules/*.dto": "./types/modules/*.dto.ts"
  },
  "peerDependencies": {
    "@voyzu/capability": "^0.1.0",
    "@voyzu/types": "^0.1.0",
    "@voyzu/ui-components": "^0.1.0",
    "@voyzu/ui-layout": "^0.1.0",
    "@voyzu/ui-style": "^0.1.0",
    "@voyzu/ui-surface": "^0.1.0",
    "next": "^16",
    "react": "^19",
    "server-only": "^0.0.1",
    "typebox": "^1.3.7",
    "@voyzu/components": "^0.1.0"
  }
}
