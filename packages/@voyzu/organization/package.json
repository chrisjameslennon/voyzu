{
  "name": "@voyzu/organization",
  "version": "0.1.0",
  "description": "Preinstalled organization, company, localization and company-context management.",
  "repository": "https://github.com/chrisjameslennon/voyzu.git",
  "private": true,
  "type": "module",
  "voyzu": {
    "voyzu-package": true,
    "allowInstall": true,
    "dependencies": [],
    "pageRootPaths": ["/organization"],
    "apiRootPaths": ["/organization", "/company-selection"],
    "preinstalled": true,
    "settings": {
      "helpBaseUrl": "https://voyzu.gitbook.io/docs/"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./voyzu-package": "./voyzu.package.ts",
    "./navigation/domains": "./navigation/domains.ts",
    "./organization": "./modules/organization/module.ts",
    "./organization/operations": "./modules/organization/operations.ts",
    "./organization/client": "./modules/organization/client/index.ts",
    "./organization/server": "./modules/organization/server/index.ts",
    "./organization/domain/operation-policy": "./modules/organization/domain/operation-policy.ts",
    "./companies": "./modules/companies/module.ts",
    "./companies/operations": "./modules/companies/operations.ts",
    "./companies/client": "./modules/companies/client/index.ts",
    "./companies/server": "./modules/companies/server/index.ts",
    "./companies/domain/operation-policy": "./modules/companies/domain/operation-policy.ts",
    "./countries": "./modules/countries/module.ts",
    "./countries/operations": "./modules/countries/operations.ts",
    "./countries/client": "./modules/countries/client/index.ts",
    "./countries/server": "./modules/countries/server/index.ts",
    "./currencies": "./modules/currencies/module.ts",
    "./currencies/operations": "./modules/currencies/operations.ts",
    "./currencies/client": "./modules/currencies/client/index.ts",
    "./currencies/server": "./modules/currencies/server/index.ts",
    "./company-switcher": "./modules/company-switcher/module.ts",
    "./company-switcher/operations": "./modules/company-switcher/operations.ts",
    "./company-switcher/client": "./modules/company-switcher/client/index.ts",
    "./company-switcher/server": "./modules/company-switcher/server/index.ts",
    "./company-switcher/types": "./modules/company-switcher/types/index.ts",
    "./organization-reports": "./modules/organization-reports/module.ts",
    "./organization-reports/server": "./modules/organization-reports/server/index.ts",
    "./common/client": "./modules/common/client/index.ts",
    "./common/server": "./modules/common/server/index.ts",
    "./common/domain/operation-policy": "./modules/common/domain/operation-policy.ts",
    "./types/constraints": "./types/constraints.ts",
    "./types/modules/*": "./types/modules/*/index.ts",
    "./types/modules/*.dto": "./types/modules/*.dto.ts"
  },
  "peerDependencies": {
    "@voyzu/audit": "^0.1.0",
    "@voyzu/auth": "^0.1.0",
    "@voyzu/capability": "^0.1.0",
    "@voyzu/types": "^0.1.0",
    "@voyzu/ui-components": "^0.1.0",
    "@voyzu/ui-layout": "^0.1.0",
    "@voyzu/ui-style": "^0.1.0",
    "@voyzu/ui-surface": "^0.1.0",
    "next": "^16",
    "react": "^19",
    "server-only": "^0.0.1",
    "typebox": "^1.3.7"
  }
}
