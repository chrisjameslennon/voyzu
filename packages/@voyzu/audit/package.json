    "./stamps": "./modules/common/server/index.ts"
  },
  "peerDependencies": {
    "@voyzu/auth": "^0.1.0",
    "@voyzu/capability": "^0.1.0",
    "@voyzu/types": "^0.1.0",
    "@voyzu/ui-components": "^0.1.0",
