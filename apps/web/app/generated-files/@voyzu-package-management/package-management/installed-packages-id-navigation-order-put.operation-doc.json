          },
          "topNavigationVisible": {
            "type": "boolean"
          },
          "pageRoutesVisible": {
            "type": "boolean"
          },
          "navOrder": {
            "type": "number"
          },
          "preinstalled": {
            "type": "boolean"
          },
          "hasTopNavigation": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "pageRootPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "apiRootPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "code",
          "description",
          "repository",
          "topNavigationVisible",
          "pageRoutesVisible",
          "navOrder",
          "preinstalled",
          "hasTopNavigation",
          "required",
          "pageRootPaths",
          "apiRootPaths"
        ],
        "additionalProperties": false
      },
      "example": {
        "id": 0,
        "code": "string",
        "description": "string",
        "repository": "string",
        "topNavigationVisible": true,
        "pageRoutesVisible": true,
        "navOrder": 0,
        "preinstalled": true,
        "hasTopNavigation": true,
        "required": true,
        "pageRootPaths": [
          "string"
        ],
        "apiRootPaths": [
          "string"
        ]
      }
    },
