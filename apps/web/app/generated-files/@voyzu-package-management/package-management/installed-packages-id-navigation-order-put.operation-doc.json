    "schema": {
      "type": "object",
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        }
      },
      "required": [
        "direction"
      ],
      "additionalProperties": false
    },
    "example": {
      "direction": "up"
    }
