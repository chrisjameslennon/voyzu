{
  "operationId": "installed-packages-id-navigation-order-put",
  "method": "put",
  "path": "/api/installed-packages/{id}/navigation-order",
  "summary": "Move Package Navigation",
  "description": "Moves a package up or down in top-navigation order.",
  "tags": [
    "Package Management"
  ],
  "requestPathParams": {
