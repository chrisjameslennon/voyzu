{
  "operationId": "package-settings-home-page-get",
  "method": "get",
  "path": "/api/package-settings/home-page",
  "summary": "Get Home Page",
  "description": "Gets the application start-page route.",
  "tags": [
    "Package Management"
  ],
  "responses": {
    "200": {
      "description": "The configured start page.",
      "schemaRef": "HomePageRouteResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string"
          }
        },
        "required": [
          "route"
        ],
        "additionalProperties": false
      },
      "example": {
        "route": "string"
      }
    },
    "400": {
      "description": "Validation failed.",
      "schemaRef": "InputValidationErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "401": {
      "description": "Authentication failed."
    },
    "403": {
      "description": "Administrator access is required."
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "schemaRef": "InternalServerErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
