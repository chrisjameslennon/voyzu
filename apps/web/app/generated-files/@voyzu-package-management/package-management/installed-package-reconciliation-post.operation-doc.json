{
  "operationId": "installed-package-reconciliation-post",
  "method": "post",
  "path": "/api/installed-package-reconciliation",
  "summary": "Refresh Package Inventory",
  "description": "Reconciles package-management records with packages installed on the filesystem.",
  "tags": [
    "Package Management"
  ],
  "responses": {
    "200": {
      "description": "The reconciled package inventory.",
      "contentType": "application/json",
      "schemaRef": {
        "type": "array",
        "items": "InstalledPackageResponseDto"
      },
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "number"
            },
            "code": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "topNavigationVisible": {
              "type": "boolean"
            },
            "pageRoutesVisible": {
              "type": "boolean"
            },
            "navOrder": {
              "type": "number"
            },
            "preinstalled": {
              "type": "boolean"
            },
            "hasTopNavigation": {
              "type": "boolean"
            },
            "required": {
              "type": "boolean"
            },
            "pageRootPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "apiRootPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "code",
            "description",
            "repository",
            "topNavigationVisible",
            "pageRoutesVisible",
            "navOrder",
            "preinstalled",
            "hasTopNavigation",
            "required",
            "pageRootPaths",
            "apiRootPaths"
          ],
          "additionalProperties": false
        }
      },
      "example": [
        {
          "id": 0,
          "code": "string",
          "description": "string",
          "repository": "string",
          "topNavigationVisible": true,
          "pageRoutesVisible": true,
          "navOrder": 0,
          "preinstalled": true,
          "hasTopNavigation": true,
          "required": true,
          "pageRootPaths": [
            "string"
          ],
          "apiRootPaths": [
            "string"
          ]
        }
      ]
    },
    "400": {
      "description": "Validation failed.",
      "contentType": "application/json",
      "schemaRef": "InputValidationErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "401": {
      "description": "Authentication failed.",
      "contentType": "application/json",
      "schemaRef": "UnauthorizedErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "UNAUTHORIZED",
        "message": "string"
      }
    },
    "403": {
      "description": "Administrator access is required.",
      "contentType": "application/json",
      "schemaRef": "ForbiddenErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FORBIDDEN"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "FORBIDDEN",
        "message": "string"
      }
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "contentType": "application/json",
      "schemaRef": "InternalServerErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
