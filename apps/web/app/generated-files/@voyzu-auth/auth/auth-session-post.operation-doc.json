{
  "operationId": "auth-session-post",
  "method": "post",
  "path": "/api/auth/session",
  "summary": "Log in",
  "description": "Authenticates a UI user and creates an authenticated session cookie.",
  "tags": [
    "Auth"
  ],
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schemaRef": "AuthLoginRequestDto",
    "schema": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "description": "User code, email address, or other configured login identifier."
        },
        "password": {
          "type": "string",
          "description": "User password."
        }
      },
      "required": [
        "identifier",
        "password"
      ],
      "additionalProperties": false
    },
    "example": {
      "identifier": "string",
      "password": "string"
    }
  },
  "responses": {
    "200": {
      "description": "The authenticated user.",
      "contentType": "application/json",
      "schemaRef": "AuthLoginResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "User business code."
              },
              "displayName": {
                "type": "string",
                "description": "User display name."
              },
              "role": {
                "type": "string",
                "description": "User role code."
              }
            },
            "required": [
              "code",
              "displayName",
              "role"
            ],
            "additionalProperties": false,
            "description": "Authenticated user."
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "example": {
        "user": {
          "code": "string",
          "displayName": "string",
          "role": "string"
        }
      },
      "cookies": {
        "voyzu_auth": {
          "description": "Authenticated UI session cookie.",
          "action": "set",
          "httpOnly": true,
          "secure": true,
          "sameSite": "lax",
          "path": "/",
          "maxAgeSeconds": 28800
        }
      }
    },
    "400": {
      "description": "Validation failed.",
      "contentType": "application/json",
      "schemaRef": "InputValidationErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "401": {
      "description": "Login credentials were invalid.",
      "contentType": "application/json",
      "schemaRef": "UnauthorizedErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "UNAUTHORIZED",
        "message": "string"
      }
    },
    "403": {
      "description": "Access is forbidden.",
      "contentType": "application/json",
      "schemaRef": "ForbiddenErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FORBIDDEN"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "FORBIDDEN",
        "message": "string"
      }
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "contentType": "application/json",
      "schemaRef": "InternalServerErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
