{
  "operationId": "auth-session-get",
  "method": "get",
  "path": "/api/auth/session",
  "summary": "Get current session",
  "description": "Returns the current UI authentication session state.",
  "tags": [
    "Auth"
  ],
  "responses": {
    "200": {
      "description": "The current session state.",
      "contentType": "application/json",
      "schemaRef": "AuthSessionResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "description": "Whether the request has an authenticated UI session."
          },
          "user": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "User business code."
                  },
                  "displayName": {
                    "type": "string",
                    "description": "User display name."
                  },
                  "role": {
                    "type": "string",
                    "description": "User role code."
                  }
                },
                "required": [
                  "code",
                  "displayName",
                  "role"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Authenticated user, when a session exists."
          }
        },
        "required": [
          "authenticated"
        ],
        "additionalProperties": false
      },
      "example": {
        "authenticated": true,
        "user": {
          "code": "string",
          "displayName": "string",
          "role": "string"
        }
      }
    },
    "400": {
      "description": "Validation failed.",
      "contentType": "application/json",
      "schemaRef": "InputValidationErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "401": {
      "description": "Authentication failed.",
      "contentType": "application/json",
      "schemaRef": "UnauthorizedErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "UNAUTHORIZED",
        "message": "string"
      }
    },
    "403": {
      "description": "Access is forbidden.",
      "contentType": "application/json",
      "schemaRef": "ForbiddenErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FORBIDDEN"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "FORBIDDEN",
        "message": "string"
      }
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "contentType": "application/json",
      "schemaRef": "InternalServerErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
