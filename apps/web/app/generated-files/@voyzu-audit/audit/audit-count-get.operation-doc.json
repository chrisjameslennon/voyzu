{
  "operationId": "audit-count-get",
  "method": "get",
  "path": "/api/audit/count",
  "summary": "Count audit events",
  "description": "Counts audit events across installed packages using the supplied filters.",
  "tags": [
    "Audit"
  ],
  "responses": {
    "200": {
      "description": "Matching audit event count.",
      "contentType": "application/json",
      "schemaRef": "AuditEventCountResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "description": "Number of audit events matching the supplied filters."
          }
        },
        "required": [
          "count"
        ],
        "additionalProperties": false
      },
      "example": {
        "count": 0
      }
    },
    "400": {
      "description": "Validation failed.",
      "contentType": "application/json",
      "schemaRef": "InputValidationErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "401": {
      "description": "Authentication failed.",
      "contentType": "application/json",
      "schemaRef": "UnauthorizedErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "UNAUTHORIZED",
        "message": "string"
      }
    },
    "403": {
      "description": "Access is forbidden.",
      "contentType": "application/json",
      "schemaRef": "ForbiddenErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FORBIDDEN"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "FORBIDDEN",
        "message": "string"
      }
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "contentType": "application/json",
      "schemaRef": "InternalServerErrorResponseDto",
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
