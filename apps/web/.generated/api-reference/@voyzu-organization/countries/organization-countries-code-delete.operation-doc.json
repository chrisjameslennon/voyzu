{
  "operationId": "organization-countries-code-delete",
  "method": "delete",
  "path": "/api/organization/countries/{code}",
  "summary": "Delete",
  "description": "Deletes a country. Countries with postings cannot be deleted.",
  "tags": [
    "Countries"
  ],
  "requestPathParams": {
