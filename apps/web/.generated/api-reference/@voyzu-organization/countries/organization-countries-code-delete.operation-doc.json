      "contentType": "application/json",
      "schemaRef": "EntityNotFoundErrorResponseDto",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ENTITY_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "ENTITY_NOT_FOUND",
        "message": "string"
      }
    },
    "422": {
