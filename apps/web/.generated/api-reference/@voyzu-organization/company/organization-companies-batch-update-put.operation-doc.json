{
  "operationId": "organization-companies-batch-update-put",
  "method": "put",
  "path": "/api/organization/companies/batch/update",
  "summary": "Batch update companies",
  "description": "Fully replaces multiple company records in a single request. Executed as a single database transaction; if any item fails, all changes are rolled back.",
  "tags": [
    "Companies"
  ],
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schemaRef": {
      "type": "array",
      "items": "CompanyBatchUpdateRequestDto"
    },
    "schema": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "countryCode",
          "baseCurrencyCode"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,13}$",
            "description": "An uppercase business code of at most 14 letters, numbers, underscores or hyphens."
          },
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "baseCurrencyCode": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "taxFilingAnchorMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "taxFilingIntervalMonths": {
            "anyOf": [
              {
                "type": "number",
                "enum": [
                  1
                ]
              },
              {
                "type": "number",
                "enum": [
                  2
                ]
              },
              {
                "type": "number",
                "enum": [
                  3
                ]
              },
              {
                "type": "number",
                "enum": [
                  6
                ]
              },
              {
                "type": "number",
                "enum": [
                  12
                ]
              }
            ]
          },
          "useOrganizationStandardSettings": {
            "type": "boolean"
          },
          "reportLine1": {
            "type": "string"
          },
          "reportLine2": {
            "type": "string"
          },
          "reportFooter": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "example": [
      {
        "code": "string",
        "name": "string",
        "countryCode": "string",
        "baseCurrencyCode": "string",
        "taxFilingAnchorMonth": 1,
        "taxFilingIntervalMonths": 1,
        "useOrganizationStandardSettings": true,
        "reportLine1": "string",
        "reportLine2": "string",
        "reportFooter": "string"
      }
    ]
  },
