{
  "operationId": "company-selection-put",
  "method": "put",
  "path": "/api/company-selection",
  "summary": "Set Selection",
  "description": "Set Selection Company Switcher.",
  "tags": [
    "Company Switcher"
  ],
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schemaRef": "CompanySelectionUpdateRequestDto",
    "schema": {
      "type": "object",
      "required": [
        "companyId"
      ],
      "properties": {
        "companyId": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "example": {
      "companyId": 1
    }
  },
  "responses": {
    "200": {
      "description": "The selected company id.",
      "contentType": "application/json",
      "schemaRef": "CompanySelectionUpdateResponseDto",
      "schema": {
        "type": "object",
        "required": [
          "selectedCompanyId"
        ],
        "properties": {
          "selectedCompanyId": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "example": {
        "selectedCompanyId": 1
      },
      "cookies": {
        "voyzuSelectedCompanyId": {
          "description": "Selected company cookie used by company-scoped UI requests.",
          "action": "set",
          "httpOnly": true,
          "sameSite": "lax",
          "path": "/",
          "maxAgeSeconds": 31536000
        }
      }
    },
    "400": {
      "description": "Validation failed.",
      "contentType": "application/json",
      "schemaRef": "InputValidationErrorResponseDto",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "404": {
      "description": "Entity not found.",
      "contentType": "application/json",
      "schemaRef": "EntityNotFoundErrorResponseDto",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ENTITY_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "ENTITY_NOT_FOUND",
        "message": "string"
      }
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "contentType": "application/json",
      "schemaRef": "InternalServerErrorResponseDto",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
