{
  "operationId": "capability-export-post",
  "method": "post",
  "path": "/api/capability/export",
  "summary": "Export Rows",
  "description": "Exports supplied tabular rows to a downloadable file.",
  "tags": [
    "Capability"
  ],
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "required": [
        "filename",
        "columns",
        "rows"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "\\S",
          "description": "Non-blank download filename without extension."
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "\\S",
                "description": "Non-blank source field key to read from each row."
              },
              "label": {
                "type": "string",
                "pattern": "\\S",
                "description": "Non-blank column heading to write in the CSV file."
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "description": "CSV columns to include in output order."
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          },
          "description": "Rows to write to the CSV file."
        }
      },
      "additionalProperties": false
    },
    "example": {
      "filename": "string",
      "columns": [
        {
          "key": "string",
          "label": "string"
        }
      ],
      "rows": [
        {}
      ]
    }
  },
  "responses": {
    "200": {
      "description": "Generated export file.",
      "contentType": "text/csv",
      "example": "column_1,column_2\nvalue_1,value_2"
    },
    "400": {
      "description": "Validation failed.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "401": {
      "description": "Authentication failed.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "UNAUTHORIZED",
        "message": "string"
      }
    },
    "403": {
      "description": "Access is forbidden.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FORBIDDEN"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "FORBIDDEN",
        "message": "string"
      }
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
