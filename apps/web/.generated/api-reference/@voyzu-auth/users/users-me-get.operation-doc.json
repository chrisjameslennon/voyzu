{
  "operationId": "users-me-get",
  "method": "get",
  "path": "/api/users/me",
  "summary": "Profile",
  "description": "Profile Users.",
  "tags": [
    "Users"
  ],
  "responses": {
    "200": {
      "description": "The current user profile.",
      "contentType": "application/json",
      "schemaRef": "UserResponseDto",
      "schema": {
        "type": "object",
        "required": [
          "id",
          "code",
          "email",
          "displayName",
          "role",
          "accessMode",
          "implementerAccess",
          "status",
          "audit"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[A-Z0-9_-]+$",
            "description": "Capital letters, numbers, dashes, and underscores; maximum 20 characters."
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\S(?:.*\\S)?$",
                "description": "A non-blank value without leading or trailing whitespace."
              },
              {
                "type": "null"
              }
            ]
          },
          "displayName": {
            "type": "string",
            "maxLength": 50,
            "pattern": "\\S",
            "description": "Non-blank display name; maximum 50 characters."
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ADMIN"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "STANDARD"
                ]
              }
            ]
          },
          "accessMode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "UI"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "API"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "UI_AND_API"
                ]
              }
            ]
          },
          "implementerAccess": {
            "type": "boolean"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ACTIVE"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "INACTIVE"
                ]
              }
            ]
          },
          "audit": {
            "type": "object",
            "required": [
              "created",
              "updated"
            ],
            "properties": {
              "created": {
                "type": "object",
                "required": [
                  "date"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date and time for the audit event."
                  },
                  "actorType": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "APP"
                            ]
                          },
                          {
                            "type": "string",
                            "enum": [
                              "API"
                            ]
                          },
                          {
                            "type": "string",
                            "enum": [
                              "SYSTEM"
                            ]
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "userId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "user": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "id",
                          "code",
                          "displayName"
                        ],
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "User id."
                          },
                          "code": {
                            "type": "string",
                            "pattern": "\\S",
                            "description": "User code."
                          },
                          "displayName": {
                            "type": "string",
                            "pattern": "\\S",
                            "description": "User display name."
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mutationId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              },
              "updated": {
                "type": "object",
                "required": [
                  "date"
                ],
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date and time for the audit event."
                  },
                  "actorType": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "APP"
                            ]
                          },
                          {
                            "type": "string",
                            "enum": [
                              "API"
                            ]
                          },
                          {
                            "type": "string",
                            "enum": [
                              "SYSTEM"
                            ]
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "userId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "user": {
                    "anyOf": [
                      {
                        "type": "object",
                        "required": [
                          "id",
                          "code",
                          "displayName"
                        ],
                        "properties": {
                          "id": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "User id."
                          },
                          "code": {
                            "type": "string",
                            "pattern": "\\S",
                            "description": "User code."
                          },
                          "displayName": {
                            "type": "string",
                            "pattern": "\\S",
                            "description": "User display name."
                          }
                        },
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mutationId": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "example": {
        "id": 1,
        "code": "string",
        "email": "string",
        "displayName": "string",
        "role": "ADMIN",
        "accessMode": "UI",
        "implementerAccess": true,
        "status": "ACTIVE",
        "audit": {
          "created": {
            "date": "2019-08-24T14:15:22Z",
            "actorType": "APP",
            "userId": "string",
            "user": {
              "id": 1,
              "code": "string",
              "displayName": "string"
            },
            "mutationId": "string"
          },
          "updated": {
            "date": "2019-08-24T14:15:22Z",
            "actorType": "APP",
            "userId": "string",
            "user": {
              "id": 1,
              "code": "string",
              "displayName": "string"
            },
            "mutationId": "string"
          }
        }
      }
