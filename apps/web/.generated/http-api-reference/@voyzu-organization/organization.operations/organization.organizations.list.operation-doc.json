{
  "operationId": "organization.organizations.list",
  "method": "get",
  "path": "/api/organization/organizations",
  "summary": "List organizations",
  "description": "Returns all organizations in the system.",
  "tags": [
    "@voyzu/organization: Platform"
  ],
  "responses": {
    "200": {
      "description": "A list of all organizations.",
      "contentType": "application/json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "code",
            "name",
            "countryCode",
            "baseCurrencyCode",
            "status",
            "audit"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
            },
            "name": {
              "type": "string",
              "pattern": "\\S"
            },
            "countryCode": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "country": {
              "type": "object",
              "required": [
                "code",
                "name"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
                },
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "baseCurrencyCode": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "baseCurrency": {
              "type": "object",
              "required": [
                "code",
                "name"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
                },
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "ACTIVE"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "INACTIVE"
                  ]
                }
              ]
            },
            "audit": {
              "type": "object",
              "required": [
                "created",
                "updated"
              ],
              "properties": {
                "created": {
                  "type": "object",
                  "required": [
                    "date"
                  ],
                  "properties": {
                    "date": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Date and time for the audit event."
                    },
                    "actorType": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "APP"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "API"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "SYSTEM"
                              ]
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "userId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "user": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "id",
                            "code",
                            "displayName"
                          ],
                          "properties": {
                            "id": {
                              "type": "integer",
                              "minimum": 1,
                              "description": "User id."
                            },
                            "code": {
                              "type": "string",
                              "pattern": "\\S",
                              "description": "User code."
                            },
                            "displayName": {
                              "type": "string",
                              "pattern": "\\S",
                              "description": "User display name."
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "mutationId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "updated": {
                  "type": "object",
                  "required": [
                    "date"
                  ],
                  "properties": {
                    "date": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Date and time for the audit event."
                    },
                    "actorType": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "APP"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "API"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "SYSTEM"
                              ]
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "userId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "user": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "id",
                            "code",
                            "displayName"
                          ],
                          "properties": {
                            "id": {
                              "type": "integer",
                              "minimum": 1,
                              "description": "User id."
                            },
                            "code": {
                              "type": "string",
                              "pattern": "\\S",
                              "description": "User code."
                            },
                            "displayName": {
                              "type": "string",
                              "pattern": "\\S",
                              "description": "User display name."
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "mutationId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "example": [
        {
          "id": 1,
          "code": "string",
          "name": "string",
          "countryCode": "string",
          "country": {
            "code": "string",
            "name": "string"
          },
          "baseCurrencyCode": "string",
          "baseCurrency": {
            "code": "string",
            "name": "string"
          },
          "status": "ACTIVE",
          "audit": {
            "created": {
              "date": "2019-08-24T14:15:22Z",
              "actorType": "APP",
              "userId": "string",
              "user": {
                "id": 1,
                "code": "string",
                "displayName": "string"
              },
              "mutationId": "string"
            },
            "updated": {
              "date": "2019-08-24T14:15:22Z",
              "actorType": "APP",
              "userId": "string",
              "user": {
                "id": 1,
                "code": "string",
                "displayName": "string"
              },
              "mutationId": "string"
            }
          }
        }
