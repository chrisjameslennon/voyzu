{
  "operationId": "organization.organization-access.replace",
  "method": "put",
  "path": "/api/organization/organization-access/{code}",
  "summary": "Replace organization access",
  "description": "Replaces all organization assignments for a standard user.",
  "tags": [
    "@voyzu/organization: Platform"
  ],
  "requestPathParams": {
    "code": {
      "description": "User code.",
      "required": true,
      "schema": {
        "type": "string"
      },
      "example": "string"
    }
  },
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "required": [
        "organizationIds"
      ],
      "properties": {
        "organizationIds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    },
    "example": {
      "organizationIds": [
        1
      ]
    }
  },
  "responses": {
    "200": {
      "description": "Updated organization access.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "userId",
          "userCode",
          "displayName",
          "userRole",
          "userStatus",
          "organizationIds"
        ],
        "properties": {
          "userId": {
            "type": "integer",
            "minimum": 1
          },
          "userCode": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "userRole": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ADMIN"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "STANDARD"
                ]
              }
            ]
          },
          "userStatus": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ACTIVE"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "INACTIVE"
                ]
              }
            ]
          },
          "organizationIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "additionalProperties": false
      },
      "example": {
        "userId": 1,
        "userCode": "string",
        "displayName": "string",
        "userRole": "ADMIN",
        "userStatus": "ACTIVE",
        "organizationIds": [
          1
        ]
      }
    },
    "400": {
      "description": "Validation failed.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "403": {
      "description": "Access is forbidden.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FORBIDDEN"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "FORBIDDEN",
        "message": "string"
      }
    },
    "404": {
      "description": "User or organization not found.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ENTITY_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "ENTITY_NOT_FOUND",
        "message": "string"
      }
    },
    "422": {
      "description": "The assignment violates a business rule.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BUSINESS_RULE"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "BUSINESS_RULE",
        "message": "string"
      }
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
