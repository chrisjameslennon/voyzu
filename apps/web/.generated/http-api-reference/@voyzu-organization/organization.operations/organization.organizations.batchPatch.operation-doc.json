{
  "operationId": "organization.organizations.batchPatch",
  "method": "patch",
  "path": "/api/organization/organizations/batch/patch",
  "summary": "Batch patch organizations",
  "description": "Partially updates multiple organization records in a single request. Executed as a single database transaction; if any item fails, all changes are rolled back.",
  "tags": [
    "@voyzu/organization: Platform"
  ],
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9_-]{0,13}$",
            "description": "An uppercase business code of at most 14 letters, numbers, underscores or hyphens."
          },
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "baseCurrencyCode": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "additionalProperties": false
      }
    },
    "example": [
      {
        "code": "string",
        "name": "string",
        "countryCode": "string",
        "baseCurrencyCode": "string"
      }
    ]
  },
  "responses": {
    "200": {
      "description": "The patched organizations.",
      "contentType": "application/json",
      "schema": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "code",
            "name",
            "countryCode",
            "baseCurrencyCode",
            "status",
            "audit"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "code": {
              "type": "string",
              "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
            },
            "name": {
              "type": "string",
              "pattern": "\\S"
            },
            "countryCode": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "country": {
              "type": "object",
              "required": [
                "code",
                "name"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
                },
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "baseCurrencyCode": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "baseCurrency": {
              "type": "object",
              "required": [
                "code",
                "name"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9_-]*$"
                },
                "name": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false
            },
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "ACTIVE"
                  ]
                },
                {
                  "type": "string",
                  "enum": [
                    "INACTIVE"
                  ]
                }
              ]
            },
            "audit": {
              "type": "object",
              "required": [
                "created",
                "updated"
              ],
              "properties": {
                "created": {
                  "type": "object",
                  "required": [
                    "date"
                  ],
                  "properties": {
                    "date": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Date and time for the audit event."
                    },
                    "actorType": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "APP"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "API"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "SYSTEM"
                              ]
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "userId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "user": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "id",
                            "code",
                            "displayName"
                          ],
                          "properties": {
                            "id": {
                              "type": "integer",
                              "minimum": 1,
                              "description": "User id."
                            },
                            "code": {
                              "type": "string",
                              "pattern": "\\S",
                              "description": "User code."
                            },
                            "displayName": {
                              "type": "string",
                              "pattern": "\\S",
                              "description": "User display name."
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "mutationId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "updated": {
                  "type": "object",
                  "required": [
                    "date"
                  ],
                  "properties": {
                    "date": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Date and time for the audit event."
                    },
                    "actorType": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "APP"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "API"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "SYSTEM"
                              ]
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "userId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "user": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "id",
                            "code",
                            "displayName"
                          ],
                          "properties": {
                            "id": {
                              "type": "integer",
                              "minimum": 1,
                              "description": "User id."
                            },
                            "code": {
                              "type": "string",
                              "pattern": "\\S",
                              "description": "User code."
                            },
                            "displayName": {
                              "type": "string",
                              "pattern": "\\S",
                              "description": "User display name."
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "mutationId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "example": [
        {
          "id": 1,
          "code": "string",
          "name": "string",
          "countryCode": "string",
          "country": {
            "code": "string",
            "name": "string"
          },
          "baseCurrencyCode": "string",
          "baseCurrency": {
            "code": "string",
            "name": "string"
          },
          "status": "ACTIVE",
          "audit": {
            "created": {
              "date": "2019-08-24T14:15:22Z",
              "actorType": "APP",
              "userId": "string",
              "user": {
                "id": 1,
                "code": "string",
                "displayName": "string"
              },
              "mutationId": "string"
            },
            "updated": {
              "date": "2019-08-24T14:15:22Z",
              "actorType": "APP",
              "userId": "string",
              "user": {
                "id": 1,
                "code": "string",
                "displayName": "string"
              },
              "mutationId": "string"
            }
          }
        }
      ]
    },
    "400": {
      "description": "Validation failed.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "404": {
      "description": "One or more organizations not found.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ENTITY_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "ENTITY_NOT_FOUND",
        "message": "string"
      }
    },
    "409": {
      "description": "One or more target codes already exist.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "CONFLICT"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "CONFLICT",
        "message": "string"
      }
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
