{
  "operationId": "auth.users.getOrganizationAccess",
  "method": "get",
  "path": "/api/users/{code}/organization-access",
  "summary": "Get user organization access",
  "description": "Gets the user's organization assignments and available organizations.",
  "tags": [
    "@voyzu/auth: Platform"
  ],
  "requestPathParams": {
    "code": {
      "description": "User code.",
      "required": true,
      "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20,
        "pattern": "^[A-Z0-9_-]+$"
      },
      "example": "string"
    }
  },
  "responses": {
    "200": {
      "description": "Organization assignments and available organizations.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "access",
          "organizations"
        ],
        "properties": {
          "access": {
            "type": "object",
            "required": [
              "userId",
              "organization_ids"
            ],
            "properties": {
              "userId": {
                "type": "integer",
                "minimum": 1
              },
              "organization_ids": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "additionalProperties": false
          },
          "organizations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "code",
                "name",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "code": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "status": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "ACTIVE"
                      ]
                    },
                    {
                      "type": "string",
                      "enum": [
                        "INACTIVE"
                      ]
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "example": {
        "access": {
          "userId": 1,
          "organization_ids": [
            1
          ]
        },
        "organizations": [
          {
            "id": 1,
            "code": "string",
            "name": "string",
            "status": "ACTIVE"
          }
        ]
      }
    },
    "400": {
      "description": "Validation failed.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INPUT_VALIDATION_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INPUT_VALIDATION_ERROR",
        "message": "string"
      }
    },
    "401": {
      "description": "Authentication failed.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHORIZED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "UNAUTHORIZED",
        "message": "string"
      }
    },
    "403": {
      "description": "Access is forbidden.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "FORBIDDEN"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "FORBIDDEN",
        "message": "string"
      }
    },
    "404": {
      "description": "User not found.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "ENTITY_NOT_FOUND"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "ENTITY_NOT_FOUND",
        "message": "string"
      }
    },
    "422": {
      "description": "A business rule prevented the operation.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BUSINESS_RULE"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "BUSINESS_RULE",
        "message": "string"
      }
    },
    "500": {
      "description": "An unexpected server error occurred.",
      "contentType": "application/json",
      "schema": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INTERNAL_SERVER_ERROR"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "example": {
        "code": "INTERNAL_SERVER_ERROR",
        "message": "string"
      }
    }
  }
}
