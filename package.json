{
  "name": "voyzu",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "lib/*",
    "packages/@voyzu/api-reference",
    "packages/@voyzu/auth",
    "packages/@voyzu/audit",
    "packages/@voyzu/foundation",
    "packages/@voyzu/localization",
    "packages/@voyzu/welcome",
    "packages/@voyzu/package-management",
    "packages/@voyzu/system-info",
    "packages/@voyzu/ui-reference"
  ],
  "scripts": {
    "build": "node lib/runtime-tools/run-npm.mjs run build -w @voyzu/web",
    "deploy": "tsx scripts/deploy/deploy.ts",
    "deps:check": "node lib/runtime-tools/run-npm.mjs outdated",
    "deps:update-major": "node lib/runtime-tools/run-npm.mjs exec --yes npm-check-updates -- --workspaces -x @types/node -u && node lib/runtime-tools/run-npm.mjs install",
    "deps:update-minor": "node lib/runtime-tools/run-npm.mjs exec --yes npm-check-updates -- --workspaces --target minor -u && node lib/runtime-tools/run-npm.mjs install",
    "dev": "node lib/runtime-tools/run-npm.mjs run dev:next",
    "dev:next": "node lib/runtime-tools/run-npm.mjs run dev -w @voyzu/web",
    "lint": "oxlint .",
    "postinstall": "node scripts/postinstall.mjs",
    "prebuild": "node lib/runtime-tools/compose/voyzu-compose.mjs --runtime . --empty-if-missing",
    "predev": "node lib/runtime-tools/compose/voyzu-compose.mjs --runtime . --empty-if-missing",
    "start": "node lib/runtime-tools/run-npm.mjs run start -w @voyzu/web",
    "test": "npm run test:operations",
    "test:operations": "node --env-file=.env.local --conditions=react-server --import tsx --test --test-concurrency=1 packages/@voyzu/auth/tests/operations/auth/auth.operations.test.ts packages/@voyzu/auth/tests/operations/users/users.operations.test.ts packages/@voyzu/audit/tests/operations/audit/audit.operations.test.ts packages/@voyzu/localization/tests/operations/countries/*.test.ts packages/@voyzu/localization/tests/operations/currencies/*.test.ts packages/@voyzu/package-management/tests/operations/package-management/package-management.operations.test.ts",
    "typecheck": "node lib/runtime-tools/run-npm.mjs run typecheck -w @voyzu/web",
    "voyzu:add-repo": "node lib/runtime-tools/commands/voyzu.mjs add repo",
    "voyzu:build-api-reference": "tsx packages/@voyzu/api-reference/scripts/build-api-reference.cli.ts",
    "voyzu:compose": "node lib/runtime-tools/commands/voyzu.mjs compose",
    "voyzu:create-package": "node lib/runtime-tools/commands/voyzu.mjs create-package",
    "voyzu:dev": "node lib/runtime-tools/commands/dev.mjs",
    "voyzu:initialize": "node lib/runtime-tools/commands/voyzu.mjs initialize",
    "voyzu:install": "node lib/runtime-tools/commands/voyzu.mjs install",
    "voyzu:install-package": "node lib/runtime-tools/commands/voyzu.mjs install-package",
    "voyzu:uninstall-package": "node lib/runtime-tools/commands/voyzu.mjs uninstall-package",
    "voyzu:link-package": "node lib/runtime-tools/commands/voyzu.mjs link-package",
    "voyzu:link-packages": "node lib/runtime-tools/commands/voyzu.mjs link-packages",
    "voyzu:list-packages": "node lib/runtime-tools/commands/voyzu.mjs list-packages",
    "voyzu:run-script": "node lib/runtime-tools/commands/voyzu.mjs run-script",
    "voyzu:start": "node lib/runtime-tools/run-npm.mjs run start",
    "voyzu:update": "node lib/runtime-tools/commands/voyzu.mjs update",
    "voyzu:update-repo": "node lib/runtime-tools/commands/voyzu.mjs update repo",
    "voyzu:update-repos": "node lib/runtime-tools/commands/voyzu.mjs update-repos"
  },
  "allowScripts": {
    "esbuild": true,
    "puppeteer": true
  },
  "dependencies": {
    "@sparticuz/chromium-min": "149.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "chokidar": "5.0.0",
    "dotenv": "17.4.2",
    "next": "16.3.1",
    "openapi-sampler": "1.7.4",
    "pg": "8.23.0",
    "puppeteer": "25.8.0",
    "puppeteer-core": "25.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "shiki": "4.4.3",
    "ts-morph": "28.0.0",
    "tsx": "4.23.12",
    "typebox": "^1.3.16",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "oxlint": "^1.79.0"
  }
}
